# Server-only Gmail settings. Never use your regular Google password.
GMAIL_ENABLED=false
GMAIL_USER=
GMAIL_AUTH_MODE=app_password
GMAIL_APP_PASSWORD=
GMAIL_FROM_NAME=Gabbai
# Optional public app URL for the email's Open Gabbai button (no trailing path).
GABBAI_PUBLIC_URL=
# OAuth alternative: create a Google Desktop app client, then run authorize-gmail.mjs.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
