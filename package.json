{
  "name": "gabbai",
  "version": "1.0.0",
  "description": "An online system that allows a synagogue and its members to coordinate Shabbat Torah readings in advance.",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "postinstall": "npm --prefix frontend ci --include=dev && npm run build",
    "test": "node ./core/main.mts",
    "dev": "vite",
    "build": "npm --prefix frontend run build",
    "preview": "vite preview",
    "lint": "eslint ."
  },
  "dependencies": {
    "@hebcal/core": "^6.13.1",
    "@hebcal/leyning": "^9.5.4",
    "bootstrap": "^5.3.8",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "react": "^19.2.6",
    "react-bootstrap": "^2.10.10",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "vite": "^8.0.12"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brandonbng23/gabbai.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/brandonbng23/gabbai/issues"
  },
  "homepage": "https://github.com/brandonbng23/gabbai#readme",
  "compilerOptions": {
    "types": [
      "node"
    ]
  },
  "allowScripts": {
    "react-bootstrap@2.10.10": true,
    "cors@2.8.6": true
  }
}
